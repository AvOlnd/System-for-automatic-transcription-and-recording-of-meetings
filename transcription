import whisper
from moviepy.editor import VideoFileClip
import os

def extract_audio_from_video(video_path, audio_output="temp_audio.wav"):
    video = VideoFileClip(video_path)
    video.audio.write_audiofile(audio_output)
    return audio_output

def transcribe_audio(audio_path, model_size="small", language="ru"):
    model = whisper.load_model(model_size)
    result = model.transcribe(audio_path, language=language)
    return result["text"]

def clean_up(audio_path):
    if os.path.exists(audio_path):
        os.remove(audio_path)

if __name__ == "__main__":
    video_file = "videotest.mp4"
    output_text_file = "transcription.txt"

    try:
        print("Извлекаем аудио из видео...")
        audio_file = extract_audio_from_video(video_file)

        print("Начинаем транскрибацию...")
        text = transcribe_audio(audio_file)

        print("\nРезультат транскрибации:")
        print(text)

        with open(output_text_file, "w", encoding="utf-8") as f:
            f.write(text)
        print(f"\nТекст сохранен в файл: {output_text_file}")

    except Exception as e:
        print(f"Произошла ошибка: {e}")
